{
  "name": "flugrekorder",
  "version": "2.0.0-beta.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rspieker/flugrekorder.git"
  },
  "bugs": {
    "url": "https://github.com/rspieker/flugrekorder/issues"
  },
  "homepage": "https://github.com/rspieker/flugrekorder#readme",
  "type": "module",
  "main": "dist/flugrekorder.js",
  "types": "dist/flugrekorder.d.ts",
  "exports": {
    ".": {
      "types": "./dist/flugrekorder.d.ts",
      "default": "./dist/flugrekorder.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "check:write": "biome check --write",
    "release": "release-it --ci",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:functional",
    "test:unit": "node --test 'source/**/*.spec.ts'",
    "test:functional": "node --test 'test/**/*.spec.ts'",
    "test:browser": "npm run build && node --test 'test/**/*.browser.ts'",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='source/**/*.ts' --test-coverage-exclude='source/**/*.spec.ts' --test 'source/**/*.spec.ts' 'test/**/*.spec.ts'",
    "prepare": "husky || true"
  },
  "keywords": [
    "proxy",
    "recorder",
    "reflect",
    "trap",
    "observer",
    "flight recorder",
    "logger"
  ],
  "author": "Rogier Spieker <rogier+npm@konfirm.eu>",
  "license": "MIT",
  "description": "A tireless, impartial, punctilious, incurious spectator. It witnesses every interaction. It takes note. It understands nothing. Remarkably, this is a feature.",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^25.9.1",
    "commitlint": "^21.2.4",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "release-it": "^21.1.1",
    "template-literal-each": "^3.0.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
